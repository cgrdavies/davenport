# Apple ID email used for iCloud.
ICLOUD_EMAIL=you@icloud.com

# App-specific password generated at appleid.apple.com
# (Sign-In and Security > App-Specific Passwords). NOT your main Apple password.
ICLOUD_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Shared secret that clients must send as `Authorization: Bearer <token>`.
# Generate a long random value, e.g. `openssl rand -hex 32`.
MCP_AUTH_TOKEN=change-me-to-a-long-random-string

# Optional. Defaults shown.
# Comma-separated extra Host headers to accept (DNS-rebinding protection).
# Required when running behind a reverse proxy on a public domain.
# Loopback (localhost/127.0.0.1/::1) is always allowed.
MCP_ALLOWED_HOSTS=your-domain.example.com

# ICLOUD_CALDAV_URL=https://caldav.icloud.com
# MCP_BIND=0.0.0.0:8000
# RUST_LOG=info
